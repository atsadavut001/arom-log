rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'avatarEmoji', 'avatarBg', 'handle', 'bio', 'streak', 'longestStreak', 'lastActiveDate', 'badges', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('avatarEmoji' in data) || (data.avatarEmoji is string && data.avatarEmoji.size() <= 32))
        && (!('avatarBg' in data) || (data.avatarBg is string && data.avatarBg.size() <= 32))
        && (!('handle' in data) || (data.handle is string && data.handle.size() <= 64))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 200))
        && (!('streak' in data) || data.streak is number)
        && (!('longestStreak' in data) || data.longestStreak is number)
        && (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 10))
        && (!('badges' in data) || (data.badges is list && data.badges.size() <= 50));
    }

    function isValidMoodEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'date', 'moodType', 'moodLabel', 'moodScore', 'moodColor', 'tags', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'date', 'moodType', 'moodLabel', 'moodScore', 'moodColor', 'customDrawing', 'tags', 'note', 'photoUrl', 'isPublic', 'likes', 'likesCount', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 64
        && data.userId is string && data.userId == request.auth.uid
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.moodType is string && data.moodType.size() <= 32
        && data.moodLabel is string && data.moodLabel.size() <= 64
        && data.moodScore is number && data.moodScore >= 0 && data.moodScore <= 10
        && data.moodColor is string && data.moodColor.size() <= 16
        && (!('customDrawing' in data) || (data.customDrawing is string && data.customDrawing.size() <= 200000))
        && data.tags is list && data.tags.size() <= 20
        && (data.tags.size() == 0 || data.tags[0] is string)
        && data.note is string && data.note.size() <= 2000
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500000))
        && (!('isPublic' in data) || data.isPublic is bool)
        && (!('likes' in data) || (data.likes is list && data.likes.size() <= 500))
        && (!('likesCount' in data) || data.likesCount is number);
    }

    // User Profile Document
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && incoming().userId == existing().userId && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // User's Followed Creators Subcollection
      match /following/{targetUserId} {
        allow get, list: if isSignedIn();
        allow create, delete: if isOwner(userId) && isValidId(targetUserId);
      }

      // User's Daily Mood Entries Subcollection
      match /entries/{entryId} {
        allow get, list: if isSignedIn();
        allow create: if isOwner(userId)
          && isValidId(entryId)
          && incoming().id == entryId
          && incoming().userId == userId
          && isValidMoodEntry(incoming());
        allow update: if isValidId(entryId) && (
          // Owner full update
          (isOwner(userId)
            && incoming().userId == existing().userId
            && incoming().id == existing().id
            && incoming().date == existing().date
            && isValidMoodEntry(incoming()))
          ||
          // Social Heart/Like update by other signed-in users
          (isSignedIn()
            && incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likesCount'])
            && incoming().likes is list
            && incoming().likes.size() <= 500
            && incoming().likesCount is number)
        );
        allow delete: if isOwner(userId) && isValidId(entryId);
      }
    }

    // Internal diagnostic collection for connection validation
    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
